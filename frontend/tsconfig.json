{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "@vera/design-tokens": ["packages/design-tokens"],
      "@vera/ui": ["packages/ui"],
      "@vera/services": ["packages/services"],
      "@vera/repositories": ["packages/repositories"],
      "@vera/config": ["packages/config"],
      "@vera/types": ["packages/types"],
      "@vera/events": ["packages/events"],
      "@app/*": ["app/*"]
    }
  },
  "include": ["src"]
}
